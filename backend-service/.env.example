# HTTP port for the backend server to bind to
PORT=8080

# URL of the FastAPI AI Service
AI_SERVICE_URL=http://localhost:8000

# Allowed CORS origins (comma-separated, * allows all)
CORS_ORIGINS=*

# Path to the HRIS SQLite database file
HRIS_DB_PATH=./hris.db

# Path to the Smart City SQLite database file
SMARTCITY_DB_PATH=./smartcity.db
