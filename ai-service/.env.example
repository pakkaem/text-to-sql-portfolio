# === AI Model Configuration ===
# Mode: "groq" (default, API cloud), "zero-shot" (model lokal), "lora" (fine-tuned model lokal)
AI_MODEL_MODE=groq

# === Groq API (untuk mode "groq") ===
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# === Zero-Shot Model (untuk mode "zero-shot") ===
# ZEROSHOT_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# === LoRA Model (untuk mode "lora") ===
# LORA_BASE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
# LORA_ADAPTER_PATH=./checkpoint-1950